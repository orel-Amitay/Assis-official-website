# Required for Google + username/password login
AUTH_SECRET=
AUTH_URL=https://assis.care
AUTH_TRUST_HOST=true

# Neon / Vercel Postgres connection string (pooled)
DATABASE_URL=

# Google OAuth Web client — redirect URIs:
#   https://assis.care/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Clarity admin — pull all merchant answers at /clarity/admin
CLARITY_ADMIN_EMAILS=nadav@assis.care
CLARITY_ADMIN_USERNAMES=
CLARITY_ADMIN_SECRET=

# Clarity AI scan — Gemini or OpenAI. Used for full store scan + per-category rescan.
GEMINI_API_KEY=
OPENAI_API_KEY=
